resource app_signature "application/x-vnd.PowerPlay";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "PowerPlay",
	long_info = "PowerPlay: an audio player with a VU meter in the Deskbar"
};

resource file_types message {
	"types" = "audio"
};
